# Cabeçalhos de segurança usados pelo Cloudflare Pages (o GitHub Pages ignora este arquivo).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' data: blob: https://*.supabase.co wss://*.supabase.co https://viacep.com.br; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

# painel: nunca dentro de outro site, nunca no Google, sempre a versão mais nova
/painel*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# link do pedido do cliente tem um código secreto: não vaza para outros sites nem vai para o Google
/pedido*
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache
